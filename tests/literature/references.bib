@inproceedings{moHetisServingLLMs2025,
	address = {St Louis, MO, USA. ACM, New York, NY, USA},
	title = {Hetis: {Serving} {LLMs} in {Heterogeneous} {GPU} {Clusters} with {Fine}-grained and {Dynamic} {Parallelism}},
	copyright = {Creative Commons Attribution 4.0 International},
	shorttitle = {Hetis},
	url = {https://doi.org/10.1145/3712285.3759784},
	doi = {10.1145/3712285.3759784},
	abstract = {The significant resource demands in LLM serving prompts production clusters to fully utilize heterogeneous hardware by partitioning LLM models across a mix of high-end and low-end GPUs. However, existing parallelization approaches often struggle to scale efficiently in heterogeneous environments due to their coarse-grained and static parallelization strategies.
 In this paper, we introduce Hetis, a new LLM system tailored for heterogeneous GPU clusters. Hetis addresses two critical challenges: (1) memory inefficiency caused by the mismatch between memory capacity and computational power in heterogeneous devices, and (2) computational inefficiency arising from performance gaps across different LLM modules. To tackle these issues, Hetis employs a fine-grained and dynamic parallelism design. Specifically, it selectively parallelizes compute-intensive operations to reduce latency and dynamically distributes Attention computations to low-end GPUs at a head granularity, leveraging the distinct characteristics of each module. Additionally, Hetis features an online load dispatching policy that continuously optimizes serving performance by carefully balancing network latency, computational load, and memory intensity. Evaluation results demonstrate that Hetis can improve serving throughput by up to \$2.25{\textbackslash}times\$ and reduce latency by \$1.49{\textbackslash}times\$ compared to existing systems.},
	urldate = {2025-09-16},
	booktitle = {The {International} {Conference} for {High} {Performance} {Computing}, {Networking}, {Storage} and {Analysis} ({SC} ’25)},
	publisher = {ACM Press},
	author = {Mo, Zizhao and Liao, Jianxiong and Xu, Huanle and Zhou, Zhi and Xu, Chengzhong},
	month = nov,
	year = {2025},
	note = {Version Number: 1},
	keywords = {concept/gpu-disaggregation, concept/kv-cache-offloading, context/gpu-cluster, context/gpu-serving, direction/systems-for-ml, feature/dynamic-parallelism, feature/fine-grained-parallelism, feature/heterogeneity-aware, genre/system, method/performance-model, method/profiling, method/rule-based-heuristic, metric/latency, metric/throughput, problem/gpu-memory-wall, problem/resource-mismatch, problem/underutilization, topic/llm, topic/model-inference, topic/performance-estimation, venue/conference/SC},
