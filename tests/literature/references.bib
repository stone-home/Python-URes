@misc{mingweiAutoscalersPerformanceEvaluation2023,
	title = {Autoscalers {Performance} {Evaluation} and {Design} of {GAScaler}},
	abstract = {In today’s digital landscape, distributed architectures have emerged as the backbone of modern application deployment, ensuring seamless scalability and optimized performance across distributed systems. Building upon this foundation, Docker containers offer consistent, isolated, and portable application environments, effectively addressing the challenges of heterogeneous infrastructure. Kubernetes takes a step further, orchestrating these containers with a promise of automated deployments and improved resource management.
Autoscaling is the key to the efficiency of Kubernetes. The autoscaler is the key component to achieve autoscaling. Autoscalers dynamically adjust resources based on workloads, ensuring optimal performance while minimizing overhead. Recognizing the critical role of autoscalers, this study embarks on a comprehensive evaluation of several scholarly proposed solutions: LOTUS, PPA, and PBScaler, using the Kubernetes Horizontal Pod Autoscaler (HPA) as a baseline. This project designs an experiment for several autoscalers in a Kubernetes cluster environment and uses round trip time (RTT) as the key comparison metric to analyze and compare each autoscaler. Based on the comparison, it is found that these autoscalers are able to effectively scale kubernetes resources to reduce round trip time. From the experimental results, objectively speaking, the scaling effect of LOTUS is the best, but due to the limitation of design, LOTUS can not be migrated to other types of applications, while both HPA, PPA, SHOWAR have a better universality, in the deployment of new applications, do not have to modify a lot of parameters, more in line with the state of the art of the application. This is more in line with the design concept of state of art.
In this paper, experiments are designed to evaluate and compare the performance of several selected autoscalers, also this paper proposes an autoscaler called GAScaler, which is different from other autoscalers in that it is based on genetic algorithms to find the optimal solution, although it does not utilize the machine learning, deep learning models for prediction, the characteristics of genetic algorithms makes it able to find the global optimal solution.},
	author = {Mingwei, Li},
	month = sep,
	year = {2023},
	keywords = {statue/readed},
}

@article{tomarchioCloudResourceOrchestration2020,
	title = {Cloud resource orchestration in the multi-cloud landscape: a systematic review of existing frameworks},
	volume = {9},
	issn = {2192-113X},
	shorttitle = {Cloud resource orchestration in the multi-cloud landscape},
	url = {https://journalofcloudcomputing.springeropen.com/articles/10.1186/s13677-020-00194-7},
	doi = {10.1186/s13677-020-00194-7},
	abstract = {Abstract
            The number of both service providers operating in the cloud market and customers consuming cloud-based services is constantly increasing, proving that the cloud computing paradigm has successfully delivered its potential. Nevertheless, the unceasing growth of the cloud market is posing hard challenges on its participants. On the provider side, the capability of orchestrating resources in order to maximise profits without failing customers’ expectations is a matter of concern. On the customer side, the efficient resource selection from a plethora of similar services advertised by a multitude of providers is an open question. In such a multi-cloud landscape, several research initiatives advocate the employment of software frameworks (namely, cloud resource orchestration frameworks - CROFs) capable of orchestrating the heterogeneous resources offered by a multitude of cloud providers in a way that best suits the customer’s need. The objective of this paper is to provide the reader with a systematic review and comparison of the most relevant CROFs found in the literature, as well as to highlight the multi-cloud computing open issues that need to be addressed by the research community in the near future.},
	language = {en},
	number = {1},
	urldate = {2023-06-01},
	journal = {Journal of Cloud Computing},
	author = {Tomarchio, Orazio and Calcaterra, Domenico and Modica, Giuseppe Di},
	month = dec,
	year = {2020},
	pages = {49},
}

@article{elhabbashCloudBrokerageSystematic2019,
	title = {Cloud {Brokerage}: {A} {Systematic} {Survey}},
	volume = {51},
	issn = {0360-0300, 1557-7341},
	shorttitle = {Cloud {Brokerage}},
	url = {https://dl.acm.org/doi/10.1145/3274657},
	doi = {10.1145/3274657},
	abstract = {Background
              —The proliferation of cloud services has opened a space for cloud brokerage services. Brokers intermediate between cloud customers and providers to assist the customer in selecting the most suitable service, helping to manage the dimensionality, heterogeneity, and uncertainty associated with cloud services.
              Objective
              —Unlike other surveys, this survey focuses on the customer perspective. The survey systematically analyses the literature to identify and classify approaches to realise cloud brokerage, presenting an understanding of the state-of-the-art and a novel taxonomy to characterise cloud brokers.
              Method
              —A systematic literature survey was conducted to compile studies related to cloud brokerage and explore how cloud brokers are engineered. These studies are then analysed from multiple perspectives, such as motivation, functionality, engineering approach, and evaluation methodology.
              Results
              —The survey resulted in a knowledge base of current proposals for realising cloud brokers. The survey identified differences between the studies’ implementations, with engineering efforts directed at combinations of market-based solutions, middlewares, toolkits, algorithms, semantic frameworks, and conceptual frameworks.
              Conclusion
              —Our comprehensive meta-analysis shows that cloud brokerage is still a formative field. Although significant progress has been achieved in this field, considerable challenges remain to be addressed, which are also identified in this survey.},
	language = {en},
	number = {6},
	urldate = {2023-06-01},
	journal = {ACM Computing Surveys},
	author = {Elhabbash, Abdessalam and Samreen, Faiza and Hadley, James and Elkhatib, Yehia},
	month = nov,
	year = {2019},
	keywords = {paper/review, statue/readed},
	pages = {1--28},
}

