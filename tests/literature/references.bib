@article{spoonSoftwareEquivalentAccuracyTransformerBased2021,
	title = {Toward {Software}-{Equivalent} {Accuracy} on {Transformer}-{Based} {Deep} {Neural} {Networks} {With} {Analog} {Memory} {Devices}},
