@misc{PeakLifeBetterCloud2025,
	title = {{PeakLife}: {Better} {Cloud} {Management} {Using} a {Deep} {Surrogate} {Model} for {VM} {Utilization} and {Lifetime} {Predictions}},
	abstract = {Efficient VM management in cloud environments
remains a critical challenge due to dynamically varying CPU
utilization and lifetimes of VMs. Existing approaches primarily
focus on utilization forecasting, but often do not incorporate
VM lifetime prediction, resulting in unnecessary migrations and
increased service-level objective (SLO) violations. To address
these challenges, we introduce PeakLife, an end-to-end deep
learning framework that combines VM utilization forecasting
and lifetime prediction to optimize VM management. Using real-
world Azure datasets, we show that PeakLife accurately captures
both average and maximum CPU utilization trends, as well
as the remaining VM lifetimes, enabling proactive migration
decisions. Experimental results demonstrate that when using
these predictions for VM management, PeakLife achieves a
reduction of up to 41.33\% in unnecessary migrations and 34.98\%
lower service-level objective (SLO) violation rates compared to
baseline approaches. Moreover, PeakLife closely matches the
performance of and oracle strategy (within 7.47\% and 1.13\% in
terms of migration counts and SLO violations), which assumes
knowledge of future VM behavior and lifetimes. PeakLife is both
generic and very light-weight, being a realistic and effective way
of data-driven, adaptive VM management in cloud environments.},
	language = {en},
	month = may,
	year = {2025},
	keywords = {cat/peer-review},
}

