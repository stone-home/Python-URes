@article{saeeduzPIDHFLAnalyzingProperty,
	title = {{PIDHFL}: {Analyzing} {Property} {Inference} {Leakage} in {Heterogeneous} {Federated} {Learning} via {Distribution}-{Aware} {Distillation}},
	abstract = {Federated learning (FL) is more frequently implemented in privacy-critical scenarios, However practical deployments are naturally heterogeneous, with clients following non-IID distributions over labels, features, and data quality. This heterogeneity, however, creates vulnerabilities to property inference attacks (PIAs), which aim to recover sensitive distribution-level properties such as the fraction of samples belonging to a sensitive group, thereby threatening privacy and undermining trust.In this study, we analyze property inference leakage in heterogeneous federated learning (HFL) and propose Property Inference Dynamics in HFL (PIDHFL). This distribution-aware distillation framework systematically examines how different training strategies impact leakage patterns. Our analysis generalizes standard distillation by shaping intermediate representations and by explicitly separating descriptive (recordlevel) from non-descriptive (distribution-level) properties using targeted regularizers that remain compatible with FedAvg. To assess leakage under realistic conditions, we design a distribution-level PIA that leverages representation statistics computed from clients’ holdout data, rather than assuming direct access to their training updates. Experiments on several face recognition benchmarks with diverse heterogeneity levels show that alignment and distillation can substantially change the risk of property inference, with attack success differing by more than 30–40\% between training schemes with similar task accuracy. These findings reveal that heterogeneity and distillation influence each other in complex ways. They demonstrate that representation-level dynamics primarily drive property inference leakage under heterogeneous conditions, rather than by task accuracy alone.},
	author = {Saeed uz, Zaman},
	keywords = {quality/trash, type/peer-review},
}

@article{wangGPEmuGPUEmulator2025,
	title = {{GPEmu}: {A} {GPU} {Emulator} for {Faster} and {Cheaper} {Prototyping} and {Evaluation} of {Deep} {Learning} {System} {Research}},
