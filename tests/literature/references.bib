@inproceedings{pmlr-v162-backstrom22a,
	series = {Proceedings of machine learning research},
	title = {{ASAP}.{SGD}: {Instance}-based adaptiveness to staleness in asynchronous {SGD}},
	volume = {162},
	url = {https://proceedings.mlr.press/v162/backstrom22a.html},
	abstract = {Concurrent algorithmic implementations of Stochastic Gradient Descent (SGD) give rise to critical questions for compute-intensive Machine Learning (ML). Asynchrony implies speedup in some contexts, and challenges in others, as stale updates may lead to slower, or non-converging executions. While previous works showed asynchrony-adaptiveness can improve stability and speedup by reducing the step size for stale updates according to static rules, there is no one-size-fits-all adaptation rule, since the optimal strategy depends on several factors. We introduce (i)\&nbsp;ASAP.SGD, an analytical framework capturing necessary and desired properties of staleness-adaptive step size functions and (ii)\&nbsp;{\textless}span style="font-variant:small-caps;"{\textgreater}tail{\textless}/span{\textgreater}-τ, a method for utilizing key properties of the ¡em¿execution instance¡/em¿, generating a tailored strategy that not only dampens the impact of stale updates, but also leverages fresh ones. We recover convergence bounds for adaptiveness functions satisfying the ASAP.SGD conditions for general, convex and non-convex problems, and establish novel bounds for ones satisfying the Polyak-Lojasiewicz property. We evaluate {\textless}span style="font-variant:small-caps;"{\textgreater}tail{\textless}/span{\textgreater}-τ with representative ¡em¿AsyncSGD¡/em¿ concurrent algorithms, for Deep Learning problems, showing {\textless}span style="font-variant:small-caps;"{\textgreater}tail{\textless}/span{\textgreater}-τ is a vital complement to ¡em¿AsyncSGD¡/em¿, with (i)\&nbsp;persistent speedup in wall-clock convergence time in the parallelism spectrum, (ii)\&nbsp;considerably lower risk of non-convergence, as well as (iii)\&nbsp;precision levels for which original SGD implementations fail.},
	booktitle = {Proceedings of the 39th international conference on machine learning},
	publisher = {PMLR},
	author = {Bäckström, Karl and Papatriantafilou, Marina and Tsigas, Philippas},
	editor = {Chaudhuri, Kamalika and Jegelka, Stefanie and Song, Le and Szepesvari, Csaba and Niu, Gang and Sabato, Sivan},
	month = jul,
	year = {2022},
	pages = {1261--1276},
}

